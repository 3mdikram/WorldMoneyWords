{
  "name": "3mdikram/worldmoneywords",
  "description": "Multilingual amount-to-words and money-to-text converter with English, Hindi, Arabic, and more through custom language packs for PHP and Laravel invoices, cheques, receipts, and payments, plus 200-country ISO support and packages for Python, Go, Java, React, TypeScript, browsers, and Node.js.",
  "type": "library",
  "license": "MIT",
  "keywords": ["amount-to-words", "amount-in-words", "amount-to-text", "amount-converter", "spell-amount", "number-to-words", "number-to-text", "number-converter", "spell-number", "money-to-words", "money-to-text", "money-converter", "currency-to-words", "currency-converter", "multi-currency", "international-currency", "multilingual", "language-support", "english", "hindi", "arabic", "cheque-amount", "cheque-writing", "check-writing", "invoice-amount", "payment-amount", "financial-tools", "currency", "php", "laravel", "python", "go", "java", "react", "typescript", "nodejs", "invoice", "cheque", "receipt", "iso-3166", "iso-4217"],
  "authors": [
    {
      "name": "Md Ikram",
      "email": "mdikram@entitysport.com",
      "homepage": "https://github.com/3mdikram"
    }
  ],
  "support": {
    "issues": "https://github.com/3mdikram/WorldMoneyWords/issues",
    "source": "https://github.com/3mdikram/WorldMoneyWords"
  },
  "require": {
    "php": "^8.1",
    "ext-intl": "*",
    "league/iso3166": "^4.3",
    "symfony/intl": "^6.4"
  },
  "autoload": {
    "psr-4": {
      "mdikram\\": "src/mdikram/",
      "AmountToWords\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AmountToWords\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "illuminate/container": "^10.0 || ^11.0 || ^12.0",
    "illuminate/support": "^10.0 || ^11.0 || ^12.0",
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "suggest": {
    "illuminate/support": "Required only when using the Laravel service provider and facade."
  },
  "extra": {
    "laravel": {
      "providers": [
        "AmountToWords\\Laravel\\AmountToWordsServiceProvider"
      ],
      "aliases": {
        "AmountToWords": "mdikram\\Facades\\AmountToWords"
      }
    }
  },
  "scripts": {
    "test": "phpunit",
    "check": ["@test", "@validate-config"],
    "validate-config": "composer validate --strict"
  },
  "config": {
    "platform": {
      "php": "8.1.0"
    },
    "sort-packages": true
  }
}
