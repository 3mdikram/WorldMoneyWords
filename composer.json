{
  "name": "3mdikram/worldmoneywords",
  "description": "Convert money amounts to words in PHP and Laravel for invoices, cheques, and financial documents, with 200-country ISO code support.",
  "type": "library",
  "license": "MIT",
  "keywords": ["amount-to-words", "number-to-words", "money-to-words", "currency", "php", "laravel", "invoice", "cheque", "iso-3166", "iso-4217"],
  "authors": [
    {
      "name": "Md Ikram",
      "email": "mdikram@entitysport.com",
      "homepage": "https://github.com/3mdikram"
    }
  ],
  "support": {
    "issues": "https://github.com/3mdikram/WorldMoneyWords/issues",
    "source": "https://github.com/3mdikram/WorldMoneyWords"
  },
  "require": {
    "php": "^8.1",
    "ext-intl": "*",
    "league/iso3166": "^4.3",
    "symfony/intl": "^6.4"
  },
  "autoload": {
    "psr-4": {
      "AmountToWords\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AmountToWords\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "scripts": {
    "test": "phpunit",
    "check": ["@test", "@validate-config"],
    "validate-config": "composer validate --strict"
  },
  "config": {
    "platform": {
      "php": "8.1.0"
    },
    "sort-packages": true
  }
}
