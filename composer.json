{
  "name": "3mdikram/worldmoneywords",
  "description": "Convert monetary amounts to words using ISO country and currency codes.",
  "type": "library",
  "license": "MIT",
  "keywords": ["amount", "currency", "money", "numbers", "words", "iso-3166", "iso-4217"],
  "authors": [
    {
      "name": "Md Ikram",
      "email": "mdikram@entitysport.com",
      "homepage": "https://github.com/3mdikram"
    }
  ],
  "support": {
    "issues": "https://github.com/3mdikram/WorldMoneyWords/issues",
    "source": "https://github.com/3mdikram/WorldMoneyWords"
  },
  "require": {
    "php": "^8.1",
    "ext-intl": "*",
    "league/iso3166": "^4.3",
    "symfony/intl": "^6.4"
  },
  "autoload": {
    "psr-4": {
      "AmountToWords\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AmountToWords\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "scripts": {
    "test": "phpunit",
    "check": ["@test", "@validate-config"],
    "validate-config": "composer validate --strict",
    "serve": "php -S 127.0.0.1:8080 api/router.php"
  },
  "config": {
    "sort-packages": true
  }
}
