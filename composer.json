{
  "name": "3mdikram/worldmoneywords",
  "description": "Amount-to-words and money-to-text converter for PHP and Laravel invoices, cheques, receipts, and payments, with 200-country ISO support.",
  "type": "library",
  "license": "MIT",
  "keywords": ["amount-to-words", "amount-in-words", "amount-to-text", "amount-converter", "spell-amount", "number-to-words", "number-to-text", "number-converter", "spell-number", "money-to-words", "money-to-text", "money-converter", "currency-to-words", "currency-converter", "multi-currency", "international-currency", "cheque-amount", "cheque-writing", "check-writing", "invoice-amount", "payment-amount", "financial-tools", "currency", "php", "laravel", "invoice", "cheque", "receipt", "iso-3166", "iso-4217"],
  "authors": [
    {
      "name": "Md Ikram",
      "email": "mdikram@entitysport.com",
      "homepage": "https://github.com/3mdikram"
    }
  ],
  "support": {
    "issues": "https://github.com/3mdikram/WorldMoneyWords/issues",
    "source": "https://github.com/3mdikram/WorldMoneyWords"
  },
  "require": {
    "php": "^8.1",
    "ext-intl": "*",
    "league/iso3166": "^4.3",
    "symfony/intl": "^6.4"
  },
  "autoload": {
    "psr-4": {
      "AmountToWords\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AmountToWords\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "scripts": {
    "test": "phpunit",
    "check": ["@test", "@validate-config"],
    "validate-config": "composer validate --strict"
  },
  "config": {
    "platform": {
      "php": "8.1.0"
    },
    "sort-packages": true
  }
}
